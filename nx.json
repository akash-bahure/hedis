{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/nx.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lockb",
      "{workspaceRoot}/Makefile"
    ],
    "contracts": [
      "{workspaceRoot}/packages/contracts/**/*"
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "build": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "dev": {
      "cache": false
    },
    "contracts": {
      "cache": true,
      "inputs": [
        "contracts"
      ]
    }
  },
  "pluginsConfig": {
    "@nx/enforce-module-boundaries": {
      "enforceBuildableLibDependency": true,
      "allow": [],
      "depConstraints": [
        {
          "sourceTag": "type:frontend",
          "onlyDependOnLibsWithTags": [
            "type:contracts",
            "type:ui"
          ]
        },
        {
          "sourceTag": "type:realtime",
          "onlyDependOnLibsWithTags": [
            "type:contracts"
          ]
        },
        {
          "sourceTag": "type:ai",
          "onlyDependOnLibsWithTags": [
            "type:contracts"
          ]
        },
        {
          "sourceTag": "type:backend",
          "onlyDependOnLibsWithTags": [
            "type:contracts"
          ]
        },
        {
          "sourceTag": "type:docs",
          "onlyDependOnLibsWithTags": [
            "type:contracts"
          ]
        }
      ]
    }
  }
}
