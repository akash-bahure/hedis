# ==============================================================================
# AI Service — Environment Variables
# ==============================================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=local                   # local | production
APP_NAME=ai-service
LOG_LEVEL=DEBUG                     # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8080

# ── LLM ──────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=                     # Your Gemini API key
GOOGLE_GENAI_USE_VERTEXAI=false     # Set to true when using Vertex AI
DEFAULT_MODEL=gemini-2.0-flash      # Any Gemini model name

# ── Database (ADK Sessions) ─────────────────────────────────────────────────
# Used by DatabaseSessionService for persistent session storage.
# Port 5433 to avoid conflict with core-api's PostgreSQL on 5432.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_service

# ── Artifact Storage ────────────────────────────────────────────────────────
# Backend options: memory | local | s3 | gcs
ARTIFACT_BACKEND=local

# Local filesystem (when ARTIFACT_BACKEND=local)
ARTIFACT_LOCAL_DIR=./artifacts

# S3-compatible storage (when ARTIFACT_BACKEND=s3)
# Works with AWS S3, MinIO, DigitalOcean Spaces, Wasabi, Backblaze B2
# ARTIFACT_S3_BUCKET=my-bucket
# ARTIFACT_S3_ENDPOINT=https://s3.amazonaws.com
# ARTIFACT_S3_REGION=us-east-1
# ARTIFACT_S3_ACCESS_KEY=
# ARTIFACT_S3_SECRET_KEY=

# Google Cloud Storage (when ARTIFACT_BACKEND=gcs)
# ARTIFACT_GCS_BUCKET=my-bucket

# ── Phoenix Observability ───────────────────────────────────────────────────
# Phoenix provides tracing and debugging for LLM/agent interactions.
# The collector endpoint receives traces via OTLP/gRPC.
PHOENIX_ENABLED=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=ai-service
