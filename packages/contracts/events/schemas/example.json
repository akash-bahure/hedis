{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/events/user-created.json",
  "title": "UserCreated",
  "description": "Emitted when a new user registers",
  "type": "object",
  "properties": {
    "event": {
      "type": "string",
      "const": "user.created"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "email": {
          "type": "string",
          "format": "email"
        }
      },
      "required": ["user_id", "email"]
    }
  },
  "required": ["event", "timestamp", "data"]
}
